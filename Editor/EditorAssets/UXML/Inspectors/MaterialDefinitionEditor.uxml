<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" editor-extension-mode="True">
    <ui:VisualElement name="OriginalMaterialContainer" style="border-bottom-color: rgb(51, 51, 51); border-bottom-width: 2px; padding-top: 0; padding-right: 0; padding-bottom: 0; padding-left: 0; border-left-color: rgb(51, 51, 51); border-right-color: rgb(51, 51, 51); border-top-color: rgb(51, 51, 51); border-top-width: 2px; border-right-width: 2px; border-left-width: 2px;">
        <ui:Label text="Original Material Reference" display-tooltip-when-elided="true" style="border-bottom-color: rgb(51, 51, 51); border-bottom-width: 2px; padding-top: 0; padding-right: 0; padding-bottom: 0; padding-left: 0;" />
        <uie:PropertyField name="MaterialAddress" />
        <uie:PropertyField name="MaterialAsset" />
    </ui:VisualElement>
    <ui:VisualElement name="MaterialInstanceContainer" style="border-bottom-color: rgb(51, 51, 51); border-bottom-width: 2px; border-left-color: rgb(51, 51, 51); border-right-color: rgb(51, 51, 51); border-top-color: rgb(51, 51, 51); border-top-width: 2px; border-right-width: 2px; border-left-width: 2px;">
        <uie:ObjectField label="Material Instance" name="MaterialInstance" class="unity-base-field__aligned" style="padding-top: 2px; padding-bottom: 2px;" />
    </ui:VisualElement>
    <ui:VisualElement name="PropertyOverridesContainer" style="border-bottom-width: 2px; border-bottom-color: rgb(51, 51, 51); border-left-color: rgb(51, 51, 51); border-right-color: rgb(51, 51, 51); border-top-color: rgb(51, 51, 51); border-top-width: 2px; border-right-width: 2px; border-left-width: 2px;">
        <ui:Label text="Property Overrides" display-tooltip-when-elided="true" style="-unity-text-align: upper-center; -unity-font-style: bold; font-size: 16px; padding-bottom: 4px; padding-top: 4px; background-color: rgb(59, 59, 59);" />
        <uie:IntegerField label="Render Queue" value="42" name="RenderQueue" class="unity-base-field__aligned" />
        <ui:IMGUIContainer name="PropertyOverridesIMGUI" />
    </ui:VisualElement>
</ui:UXML>
